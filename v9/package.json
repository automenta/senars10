{
  "name": "senars-v2",
  "version": "2.0.0",
  "description": "SeNARS - Semantic Non-axiomatic Reasoning System - v2 Implementation",
  "type": "module",
  "scripts": {
    "test": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-vm-modules npx jest",
    "test:core": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-vm-modules npx jest",
    "test:all": "npm run test:core && npm run test:ui",
    "test:ui": "npm run --prefix ui test:run",
    "ui": "npm run --prefix ui dev",
    "ui:build": "npm run --prefix ui build",
    "ui:preview": "npm run --prefix ui preview",
    "server": "node core/server.mjs"
  },
  "keywords": [
    "senars",
    "agi",
    "nars",
    "cognitive-architecture",
    "neuro-symbolic"
  ],
  "author": "SeNARS Community",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@langchain/ollama": "^0.2.4",
    "@xenova/transformers": "^2.17.2",
    "@y/websocket-server": "^0.1.1",
    "blessed": "^0.1.81",
    "chokidar": "^3.6.0",
    "esm": "^3.2.25",
    "express": "^5.1.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.4.5",
    "js-sha256": "^0.11.0",
    "langchain": "^0.3.0",
    "ws": "^8.18.3",
    "y-websocket": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-syntax-import-meta": "^7.10.4",
    "@babel/preset-env": "^7.28.3",
    "babel-jest": "^30.2.0",
    "jest": "^30.2.0"
  }
}
